# Copy to .env and adjust. Never commit the real .env file.
# All values below are optional; the server runs with safe defaults.

# HTTP listener (defaults: 127.0.0.1:3000)
PORT=3000
HOST=127.0.0.1

# Public origin used for sitemap.xml links (no trailing slash).
# Example: https://kuldeepmalviya.com
SITE_URL=

# Set to 1 when serving behind an HTTPS proxy if the proxy does not send
# X-Forwarded-Proto. Makes the admin session cookie Secure.
COOKIE_SECURE=0

# Required only for first-admin setup. Generate a long random value, use it
# once in /admin, then remove it from the deployed environment.
ADMIN_BOOTSTRAP_TOKEN=ZiKOBGIiUEGXz-LIirjEKOtTX7epuh92jlHFEnALbHo

# Keep json until the migration reports verified. No silent fallback in cloud mode.
DATA_STORE=firestore
FIREBASE_PROJECT_ID=kuldeep-malviya-portfolio


# Server-only credentials, outside public assets. Never commit the actual file.
# On Google Cloud, prefer a workload identity / attached service account instead.
# GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/private/path/portfolio-server.json
