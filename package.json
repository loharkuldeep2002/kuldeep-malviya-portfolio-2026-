{
  "name": "kuldeep-malviya-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio and private CMS with local JSON migration source and Cloud Firestore persistence",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
